# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
# Set to 0.0.0.0 only when deploying behind a real web server
HOST=127.0.0.1
# 1 = Flask debug mode. Never turn this on for a server other people can reach.
FLASK_DEBUG=0
# Websites allowed to call the API (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://127.0.0.1:5502,http://localhost:5502
# 0 on your own computer. 1 on a host like Render, so lockouts and limits see each visitor's real IP.
TRUSTED_PROXY_HOPS=0

# MongoDB Atlas connection string
MONGO_URI=

# Gmail SMTP (use a Google App Password, not your account password)
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=
# Where admin "Forgot password?" reset links are sent (the site owner). Defaults to NOTIFICATION_EMAIL.
ADMIN_EMAIL=
# Carrier gateway address used by test_sms.py, e.g. 5551234567@txt.att.net
DESTINATION_CARRIER_SMS=

# Recovery password for the admin dashboard (frontendJuanse/admin.html). Always works, even after
# the owner sets their own password from the dashboard. Use a long, unique password and keep it private.
ADMIN_PASSWORD=
