# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
# Set to 0.0.0.0 only when deploying behind a real web server
HOST=127.0.0.1
# 1 = Flask debug mode. Never turn this on for a server other people can reach.
FLASK_DEBUG=0
# Websites allowed to call the API (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://127.0.0.1:5502,http://localhost:5502

# MongoDB Atlas connection string
MONGO_URI=

# Gmail SMTP (use a Google App Password, not your account password)
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=
# Carrier gateway address used by test_sms.py, e.g. 5551234567@txt.att.net
DESTINATION_CARRIER_SMS=

# Long random string; send as "Authorization: Bearer <token>" to read /api/admin/stats
ADMIN_TOKEN=
